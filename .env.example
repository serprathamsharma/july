# HH Goa 2026 - Voice RAG Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Sarvam Speech-to-Text API
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text-translate

# LLM Provider Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-2.5-flash

# Embeddings Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage & Indexes Paths
INDEX_DIR=data/indexes
DATASET_NAME=ai4bharat/MSMARCO-XI
MAX_INGEST_DOCUMENTS=1000

# Retrieval & Guardrails Configuration
RETRIEVAL_TOP_K=5
RELEVANCE_THRESHOLD=0.012
